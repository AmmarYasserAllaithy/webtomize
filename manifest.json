{
  "name": "Webtomize",
  "version": "1.8",
  "description": "Web customizer: Inject style to websites, change videos playback rate, parse URLs, quick open favorite websites.",
  "author": "Ammar Yasser",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "js": ["src/scripts/styler.js"],
      "matches": ["*://*/*"],
      "run_at": "document_start"
    },
    {
      "js": ["src/scripts/gmail-handler.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/style/styler.scss"],
      "matches": ["*://*/*"]
    },
    {
      "resources": ["assets/html/email-body.html"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "icons": {
    "16": "assets/icons/ic_maintenance_16.png",
    "32": "assets/icons/ic_maintenance_32.png",
    "48": "assets/icons/ic_maintenance_64.png",
    "128": "assets/icons/ic_maintenance_128.png"
  }
}
